# Reference only: configure these in Vercel Settings > Environment Variables.
# Never put actual database passwords or mail credentials in the static blog.
SITE_NAME=Gudu 的个人博客
SITE_URL=https://gudu.blog

# Replace both example.com values with your actual HTTPS service address.
SERVER_URL=https://comments.example.com
SECURE_DOMAINS=gudu.blog,comments.example.com

LOGIN=disable
COMMENT_AUDIT=true
IPQPS=60
DISABLE_REGION=true
DISABLE_USERAGENT=true
AKISMET_KEY=false

# Connect Neon through Vercel Storage, then import the official waline.pgsql.
# The integration supplies database connection variables. No credentials here.

# Optional after configuring a mail provider; email is not required to comment.
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=
# SMTP_PASS=
# SENDER_NAME=Gudu 的个人博客
# SENDER_EMAIL=

# Optional Turnstile; also set content/comments.json turnstileKey in the blog.
# TURNSTILE_KEY=
# TURNSTILE_SECRET=
